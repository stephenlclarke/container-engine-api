load("@build_bazel_rules_swift//swift:swift_library.bzl", "swift_library")
load("@build_bazel_rules_swift//swift:swift_test.bzl", "swift_test")

package(default_visibility = ["//visibility:public"])
SWIFT_COPTS = ["-swift-version", "6", "-warnings-as-errors", "-package-name", "container_engine_api"]

swift_library(
    name = "ContainerEngineWire", module_name = "ContainerEngineWire",
    srcs = glob(["Sources/ContainerEngineWire/*.swift"]), copts = SWIFT_COPTS,
)
swift_library(
    name = "ContainerUnixHTTPClient", module_name = "ContainerUnixHTTPClient",
    srcs = glob(["Sources/ContainerUnixHTTPClient/*.swift"]), copts = SWIFT_COPTS,
    deps = [":ContainerEngineWire"],
)
swift_library(
    name = "ContainerEngineRouter", module_name = "ContainerEngineRouter",
    srcs = glob(["Sources/ContainerEngineRouter/*.swift"]), copts = SWIFT_COPTS,
    deps = [":ContainerEngineWire"],
)
swift_library(
    name = "ContainerEngineRuntimeSPI", module_name = "ContainerEngineRuntimeSPI",
    srcs = glob(["Sources/ContainerEngineRuntimeSPI/*.swift"]), copts = SWIFT_COPTS,
    linkopts = ["-framework", "Security"],
)
swift_library(
    name = "ContainerEngineProviderSession", module_name = "ContainerEngineProviderSession",
    srcs = glob(["Sources/ContainerEngineProviderSession/*.swift"]), copts = SWIFT_COPTS,
    deps = [":ContainerEngineRuntimeSPI", ":ContainerEngineWire"],
)
swift_library(
    name = "ContainerEngineGateway", module_name = "ContainerEngineGateway",
    srcs = glob(["Sources/ContainerEngineGateway/*.swift"]), copts = SWIFT_COPTS,
    deps = [":ContainerEngineProviderSession", ":ContainerEngineRouter", ":ContainerEngineRuntimeSPI", ":ContainerEngineWire"],
)
swift_library(
    name = "ContainerUnixHTTPServer", module_name = "ContainerUnixHTTPServer",
    srcs = glob(["Sources/ContainerUnixHTTPServer/*.swift"]), copts = SWIFT_COPTS,
    deps = [
        ":ContainerEngineWire", "@swiftpkg_swift_collections//:DequeModule",
        "@swiftpkg_swift_log//:Logging", "@swiftpkg_swift_nio//:NIOCore",
        "@swiftpkg_swift_nio//:NIOFoundationCompat", "@swiftpkg_swift_nio//:NIOHTTP1",
        "@swiftpkg_swift_nio//:NIOPosix", "@swiftpkg_swift_nio//:NIOWebSocket",
    ],
)
swift_test(
    name = "ContainerUnixHTTPClientTests", module_name = "ContainerUnixHTTPClientTests",
    timeout = "short",
    srcs = glob(["Tests/ContainerUnixHTTPClientTests/*.swift"]), copts = SWIFT_COPTS,
    deps = [":ContainerUnixHTTPClient", ":ContainerEngineWire", ":ContainerUnixHTTPServer", "@swiftpkg_swift_log//:Logging"],
)
swift_test(
    name = "ContainerEngineGatewayTests", module_name = "ContainerEngineGatewayTests",
    timeout = "short",
    env = {"DEVCONTAINER_TEST_STANDALONE": "1"},
    srcs = glob(["Tests/ContainerEngineGatewayTests/*.swift"]), copts = SWIFT_COPTS,
    deps = [":ContainerEngineGateway", ":ContainerEngineProviderSession", ":ContainerEngineRuntimeSPI",
            ":ContainerEngineWire", ":ContainerUnixHTTPServer", "@swiftpkg_swift_log//:Logging"],
)
